# odoo-runner config file.
#
# Copy this file to .env inside the addons dir (or module dir) you pass to
# --dir. odoo-runner reads it automatically. Every key here can also be set
# as a CLI flag or a process environment variable.
#
# Precedence (highest wins): CLI flag > process env var > this .env file >
# built-in default.

# Odoo image tag/version. Passed straight to `docker run odoo:<value>`, so
# any tag Docker Hub publishes works ("19.0", "18.0", "latest").
# CLI equivalent: --odoo VER
# Default if unset: "latest" (odoo-runner prints a warning when it falls
# back to this).
ODOO_RUNNER_ODOO_VERSION=19.0

# Build and use the Chrome-enabled derived image, needed for HttpCase and
# tour tests. amd64 only in v1 (see README limitations).
# CLI equivalent: --browser
# Values: 1, true, yes, on (anything else is treated as unset/false).
# Default: unset (false)
ODOO_RUNNER_BROWSER=

# Fixed port for --demo mode. Leave unset to auto-pick a free port.
# CLI equivalent: --port N
# Default: unset (auto-pick)
ODOO_RUNNER_PORT=

# Passthrough to `odoo --test-tags`. Syntax: [-][tag][/module][:class][.method]
# CLI equivalent: --test-tags SPECS
# Default: unset. odoo-runner then scopes the run to the target module(s)
# automatically (equivalent to "/module_a,/module_b"), so a first-ever test
# run does not also re-run Odoo's own bundled base/web test suite.
ODOO_RUNNER_TEST_TAGS=
