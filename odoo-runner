def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="odoo-runner",
        description="Disposable Docker runner for Odoo module tests, upgrades, demos, and shells.",
    )
    parser.add_argument(
        "--dir", metavar="PATH", help="Addons dir or single module dir. Default: cwd."
    )
    parser.add_argument(
        "--modules",
        metavar="A,B",
        help="Comma-separated module list. Default: auto-discovered.",
    )
    parser.add_argument(
        "--requirements",
        metavar="FILE",
        help="Default: auto-detect <dir>/requirements.txt.",
    )
    parser.add_argument(
        "--odoo",
        metavar="VER",
        help="Odoo image tag/version. Default: ODOO_RUNNER_ODOO_VERSION or 'latest'.",
    )

    mode_group = parser.add_mutually_exclusive_group()
    mode_group.add_argument(
        "--demo", action="store_true", help="Run a live demo server instead of tests."
    )
    mode_group.add_argument(
        "--shell",
        action="store_true",
        help="Open an interactive odoo shell instead of tests.",
    )

    parser.add_argument(
        "--test-tags", metavar="SPECS", help="Passthrough to odoo --test-tags."
    )
    parser.add_argument(
        "--upgrade-test",
        action="store_true",
        help="After install+test passes, re-run with -u + tests.",
    )
    parser.add_argument(
        "--browser",
        action="store_true",
        help="Browser-enabled derived image (Chrome for HttpCase/tours).",
    )
    parser.add_argument(
        "--port", type=int, metavar="N", help="Demo port. Default: auto-pick free port."
    )
    parser.add_argument(
        "--persist",
        action="store_true",
        help="Use named volumes keyed by project+version.",
    )
    parser.add_argument(
        "--fresh", action="store_true", help="Wipe named volumes before starting."
    )
    parser.add_argument(
        "--rebuild",
        action="store_true",
        help="Force derived-image rebuild (--no-cache).",
    )
    parser.add_argument(
        "--verbose",
        action="store_true",
        help="Stream full log instead of filtered output.",
    )
    parser.add_argument("--dry-run", action="store_true", help=argparse.SUPPRESS)
    return parser


def print_plan(
    config: Config, addons_dir: Path, modules: list[str], image_tag: str
) -> None:
    print("odoo-runner resolved plan (--dry-run)")
    print(f"  mode:          {config.mode}")
    print(f"  dir:           {config.dir}")
    print(f"  addons_dir:    {addons_dir}")
    print(f"  modules:       {', '.join(modules)}")
    print(f"  requirements:  {config.requirements or '(none)'}")
    print(f"  odoo_version:  {config.odoo_version}")
    print(f"  image:         {image_tag}")
    effective_test_tags = config.test_tags or ",".join(f"/{m}" for m in modules)
    print(f"  test_tags:     {effective_test_tags} (test mode only)")
    print(f"  upgrade_test:  {config.upgrade_test}")
    print(f"  browser:       {config.browser}")
    print(f"  port:          {config.port if config.port is not None else '(auto)'}")
    print(f"  persist:       {config.persist}")
    print(f"  fresh:         {config.fresh}")
    print(f"  rebuild:       {config.rebuild}")
    print(f"  verbose:       {config.verbose}")


def install_sigterm_handler() -> None:
    def _handler(signum: int, frame: object) -> None:
        raise SystemExit(143)  # 128 + SIGTERM, conventional shell exit code

    signal.signal(signal.SIGTERM, _handler)


def main() -> int:
    # Force line buffering even when stdout/stderr are redirected to a file
    # or pipe (not a TTY), so streamed test/demo output appears in real
    # time instead of arriving in one block at process exit.
    sys.stdout.reconfigure(line_buffering=True)
    sys.stderr.reconfigure(line_buffering=True)
    install_sigterm_handler()
    parser = build_parser()
    args = parser.parse_args()

    try:
        config, addons_dir, modules = build_config(args)
    except ConfigError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return EXIT_USAGE_ERROR

    if not docker_available():
        print(
            "error: docker is not available or the daemon is not running",
            file=sys.stderr,
        )
        return EXIT_INFRA_ERROR

    if config.dry_run:
        image_tag = compute_image_tag(
            config.odoo_version, config.browser, config.requirements
        )
        print_plan(config, addons_dir, modules, image_tag)
        return EXIT_PASS

    runner = Runner(config, addons_dir, modules)
    try:
        return runner.run()
    except InfraError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return EXIT_INFRA_ERROR
    except KeyboardInterrupt:
        print("\ninterrupted, tearing down ...", file=sys.stderr)
        return 130
    except SystemExit as exc:
        print("\nterminated, tearing down ...", file=sys.stderr)
        return exc.code if isinstance(exc.code, int) else 143
    finally:
        runner.teardown()


if __name__ == "__main__":
    sys.exit(main())
